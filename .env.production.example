# Copy to .env.production and replace every CHANGE_ME value before deployment.
APP_DOMAIN=shieldiq.example.gov.in
APP_PORT=8080
# Use docker/Dockerfile.ai when deploying the heavyweight CV, Whisper, and transformer stack.
BACKEND_DOCKERFILE=Dockerfile

SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
POSTGRES_DB=shieldiq
POSTGRES_USER=shieldiq
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
REDIS_PASSWORD=CHANGE_ME_redis_password
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password

WEB_CONCURRENCY=2
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
RATE_LIMIT=100/minute
MAX_UPLOAD_MB=10
STORAGE_PATH=/app/storage

ASSISTANT_PROVIDER=auto
ASSISTANT_REQUEST_TIMEOUT_SECONDS=45
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

MHA_ALERT_WEBHOOK_URL=
BANK_HOLD_WEBHOOK_URL=
NCRB_WEBHOOK_URL=
CHANNEL_WEBHOOK_SECRET=
INTEGRATION_WEBHOOK_SECRET=

CURRENCY_YOLO_PATH=
CURRENCY_CLASSIFIER_PATH=
CURRENCY_CLASSIFIER_ARCH=efficientnet_b0
CURRENCY_OCR_GPU=false
CURRENCY_OCR_DOWNLOAD_ENABLED=false

DEMO_MODE=false
